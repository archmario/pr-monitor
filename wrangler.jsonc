{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The Worker that runs the Next.js server, built by `opennextjs-cloudflare build`.
	"main": ".open-next/worker.js",
	"name": "pr-monitor",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Static files (JS, CSS, fonts) served straight from Cloudflare.
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference used by OpenNext internally; must match "name" above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "pr-monitor"
		}
	]
	// No R2 cache or image binding: every data page is rendered fresh per
	// request and the app doesn't use next/image. See opennext.js.org/cloudflare.
}
